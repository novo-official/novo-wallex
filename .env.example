# Copy to .env and fill in. Never commit .env (it is in .gitignore).

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-local-only
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=wallex
POSTGRES_USER=wallex
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

WALLEX_BASE_URL=https://api.wallex.ir
WALLEX_API_KEY=
WALLEX_TIMEOUT_SECONDS=10
WALLEX_MAX_RETRIES=3
WALLEX_REQUESTS_PER_SECOND=5

# Live trading needs BOTH `--mode live` and this flag set to true. Keep it false.
LIVE_TRADING_CONFIRMED=false
